# ---------------------------------------------------------------------------
# Kinvo backend — environment configuration
#
# Copy to `.env` and adjust. Every variable listed here is validated at boot by
# src/config/env.ts; the process exits rather than starting half-configured.
#
# Variables marked REQUIRED have no default and must be present.
# ---------------------------------------------------------------------------

# Runtime environment. One of: development | test | production
# Default: development
NODE_ENV=development

# HTTP port the API listens on.
# Default: 3000
PORT=3000

# Interface to bind. Use 0.0.0.0 in containers, 127.0.0.1 to stay local-only.
# Default: 0.0.0.0
HOST=0.0.0.0

# Pino log level. One of: fatal | error | warn | info | debug | trace | silent
# Default: info
LOG_LEVEL=debug

# REQUIRED. Postgres connection string. Must use postgres:// or postgresql://.
# Matches the docker-compose service (host port 5433 to avoid colliding with a
# local Postgres install). PostGIS is required from Batch 1.
DATABASE_URL=postgresql://kinvo:kinvo@localhost:5433/kinvo_dev

# REQUIRED. Redis connection string. Must use redis:// or rediss://.
# Cache, quota counters, and the BullMQ job queues all share this instance.
REDIS_URL=redis://localhost:6380

# Comma-separated list of allowed browser origins for the future admin web
# client. "*" allows any origin and is for local development only — set real
# origins in production.
# Default: *
CORS_ORIGINS=*

# Maximum accepted JSON / urlencoded request body, in a format the Express body
# parser understands (e.g. 512kb, 1mb). File uploads are multipart and get their
# own limits in Batch 4.
# Default: 1mb
JSON_BODY_LIMIT=1mb

# ---------------------------------------------------------------------------
# Auth (Batch 2)
# ---------------------------------------------------------------------------

# REQUIRED, both of them. Minimum 32 characters, and they must differ from each
# other — an access token must not verify as a refresh token.
# There is deliberately no default: a signing secret with a fallback is not a
# secret, and every token would be forgeable.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-48-random-bytes-minimum-32-chars
JWT_REFRESH_SECRET=replace-me-with-different-48-random-bytes-value

# JWT `iss` claim. Default: kinvo
JWT_ISSUER=kinvo

# Password reset link lifetime, in minutes. Spec: one hour. Default: 60
PASSWORD_RESET_TTL_MINUTES=60

# --- Twilio Verify (phone OTP) ---
# Optional in development and test, REQUIRED in production — the server refuses
# to start in production without all three.
# Without them, development falls back to a stub that accepts the code 000000
# and sends no SMS. That fallback cannot engage in production.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- Google Sign-In ---
# Comma-separated. iOS, Android, and web each have their own client ID and all
# are valid audiences for this backend.
# Optional in development, REQUIRED in production.
GOOGLE_OAUTH_CLIENT_IDS=

# --- Sign in with Apple ---
# Comma-separated bundle identifiers / service IDs.
# Optional in development, REQUIRED in production.
APPLE_CLIENT_IDS=

# ---------------------------------------------------------------------------
# Media storage (Batch 4)
# ---------------------------------------------------------------------------

# S3 in every environment. Locally that S3 is MinIO from docker-compose, which
# speaks the same API — so the SDK, the presigning, and the private-bucket
# policy are all real, and moving to AWS is a change of these values only.

# Set for MinIO. LEAVE BLANK for real AWS S3, which resolves its own endpoint.
S3_ENDPOINT=http://localhost:9100

# MinIO addresses buckets by path; AWS by virtual host. true for MinIO.
S3_FORCE_PATH_STYLE=true

S3_REGION=us-east-1

# REQUIRED in production. On AWS, prefer an instance role over static keys.
S3_ACCESS_KEY_ID=kinvo
S3_SECRET_ACCESS_KEY=kinvo-dev-secret

# Two buckets, deliberately. Verification documents carry stricter lifecycle
# rules and a much shorter URL lifetime than profile photos, and government ID
# images must never share a bucket policy with selfies.
S3_MEDIA_BUCKET=kinvo-media
S3_VERIFICATION_BUCKET=kinvo-verification

# Presigned URL lifetimes, in seconds.
S3_UPLOAD_URL_TTL_SECONDS=300
S3_DOWNLOAD_URL_TTL_SECONDS=3600
S3_VERIFICATION_URL_TTL_SECONDS=300

# Approve uploaded media on arrival instead of leaving it pending.
# Nothing moves a photo from pending to approved until the moderation pipeline
# arrives in Batch 10, so without this no uploaded photo would be visible to
# anyone. FORCED OFF in production — the server refuses to start with it on.

# ---------------------------------------------------------------------------
# Added in later batches — intentionally not validated yet, so the server does
# not demand credentials for services it has no code to call. Each becomes a
# REQUIRED entry above in the batch that introduces it.
#   Batch 11 notify     FIREBASE_SERVICE_ACCOUNT_JSON,
#                       SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD,
#                       MAIL_FROM_ADDRESS
#   Batch 13 payments   APPLE_IAP_ISSUER_ID, APPLE_IAP_KEY_ID,
#                       APPLE_IAP_PRIVATE_KEY, APPLE_BUNDLE_ID,
#                       GOOGLE_PLAY_SERVICE_ACCOUNT_JSON,
#                       GOOGLE_PLAY_PACKAGE_NAME, GOOGLE_PUBSUB_TOPIC,
#                       STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET
#   Batch 14 calls      TWILIO_API_KEY_SID, TWILIO_API_KEY_SECRET
# ---------------------------------------------------------------------------

# --- Notifications (Batch 11) -----------------------------------------------
# Firebase service-account JSON on ONE line. Held in SSM on deployed
# environments and injected as this variable — never written to disk on the
# instance, because a key file on a box ends up in an image or a backup.
#
# Absent, push falls back to a no-op. Safe only because every notification is
# persisted to the feed first: the user still sees it in the app, they just get
# no banner.
FIREBASE_SERVICE_ACCOUNT_JSON=

# SMTP. All four must be set together or email falls back to a no-op — a
# half-configured transport fails at send time, the worst place to find out.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
